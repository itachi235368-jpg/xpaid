# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SOLANA_RPC_URL: Solana Mainnet RPC endpoint (Helius / QuickNode)
SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key="

# SOLANA_TREASURY_PUBKEY: Protocol treasury wallet address receiving Pump.fun royalties
SOLANA_TREASURY_PUBKEY="ChKVce7smxzqrtFGxbdBA1d4ZSazfDwWNZbJUcU6EMy8"

# HELIUS_WEBHOOK_ID: Active Helius Enhanced Webhook ID watching treasury inflows
HELIUS_WEBHOOK_ID="f6949cec-0fc4-4734-b6d0-ae74f6cbf96c"

# PINATA_JWT: Pinata IPFS JWT for decentralized token logo & JSON metadata storage
PINATA_JWT="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# X_BEARER_TOKEN: 𝕏 / Twitter Developer API v2 Bearer Token for creator resolution & verified proofs
X_BEARER_TOKEN="AAAAAAAAAAAAAAAAAAAAA..."

# X_PAYMENTS_PARTNER_SECRET: 𝕏 Payments LLC / 𝕏 Money settlement partner secret
X_PAYMENTS_PARTNER_SECRET="xp_sec_..."

# KRAKEN_API_KEY: Kraken Exchange API key for automated crypto-to-USD off-ramp liquidation
